{
  "name": "vscode-cf-inline",
  "displayName": "Codeforces Inline",
  "description": "在 VS Code 集成浏览器中保留 Codeforces 原文并生成独立中文译文。",
  "version": "0.11.35",
  "publisher": "codex-local",
  "author": "zxt-fine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zxt-fine/vscode-cf-inline.git"
  },
  "homepage": "https://github.com/zxt-fine/vscode-cf-inline#readme",
  "bugs": {
    "url": "https://github.com/zxt-fine/vscode-cf-inline/issues"
  },
  "keywords": [
    "codeforces",
    "competitive-programming",
    "vscode-extension",
    "translation",
    "chinese"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cfInline.open",
        "title": "Codeforces Inline: 打开 Codeforces 翻译浏览器"
      },
      {
        "command": "cfInline.openIntegratedBrowser",
        "title": "Codeforces Inline: 在 VS Code 集成浏览器中打开"
      },
      {
        "command": "cfInline.openPanel",
        "title": "Codeforces Inline: 打开旧版内嵌面板"
      },
      {
        "command": "cfInline.openLogin",
        "title": "Codeforces Inline: 登录并连接 Edge 会话"
      },
      {
        "command": "cfInline.installEdgeExtension",
        "title": "Codeforces Inline: 安装配套 Edge 扩展"
      },
      {
        "command": "cfInline.openDashboard",
        "title": "Codeforces Inline: 打开个人刷题仪表盘"
      },
      {
        "command": "cfInline.configureAiTranslation",
        "title": "Codeforces Inline: 配置 AI 增强翻译"
      },
      {
        "command": "cfInline.selectTranslationMode",
        "title": "Codeforces Inline: 选择翻译模式"
      },
      {
        "command": "cfInline.setAiApiKey",
        "title": "Codeforces Inline: 更新并验证 AI API Key"
      },
      {
        "command": "cfInline.clearAiApiKey",
        "title": "Codeforces Inline: 清除 AI API Key"
      },
      {
        "command": "cfInline.testAiTranslation",
        "title": "Codeforces Inline: 测试 AI 增强翻译连接"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cfInline-activity",
          "title": "Codeforces Inline",
          "icon": "assets/codeforces.svg"
        }
      ]
    },
    "views": {
      "cfInline-activity": [
        {
          "id": "cfInline.activityView",
          "name": "Codeforces",
          "contextualTitle": "Codeforces Inline"
        }
      ]
    },
    "configuration": {
      "title": "Codeforces Inline",
      "properties": {
        "cfInline.defaultPath": {
          "type": "string",
          "default": "/",
          "description": "打开查看器时使用的路径；默认显示 Codeforces 主页。"
        },
        "cfInline.proxyPort": {
          "type": "number",
          "default": 53005,
          "description": "集成浏览器页面使用的本地服务端口；固定端口可让 VS Code 重启后恢复原来的浏览器标签页，0 表示每次自动选择空闲端口。"
        },
        "cfInline.viewer": {
          "type": "string",
          "enum": [
            "integratedBrowser",
            "embeddedPanel"
          ],
          "enumDescriptions": [
            "使用 VS Code 集成浏览器作为主要 Codeforces 界面。",
            "使用插件旧版的 iframe 内嵌面板。"
          ],
          "default": "integratedBrowser",
          "description": "选择汉化和翻译后的 Codeforces 页面显示位置。"
        },
        "cfInline.fastMode": {
          "type": "boolean",
          "default": true,
          "description": "打开插件时默认进入极速界面；极速界面和正常界面仍可在页面顶部随时切换。"
        },
        "cfInline.defaultLanguage": {
          "type": "string",
          "default": "auto",
          "description": "提交语言偏好，例如 GNU++20；auto 会根据当前文件扩展名选择。"
        },
        "cfInline.localizeInterface": {
          "type": "boolean",
          "default": true,
          "description": "将常用 Codeforces 界面文字翻译为简体中文。"
        },
        "cfInline.autoTranslateStatements": {
          "type": "boolean",
          "default": true,
          "description": "自动在英文或俄文原题下方生成简体中文译文，并保护代码、公式、图片和样例。"
        },
        "cfInline.aiTranslationEnabled": {
          "type": "boolean",
          "default": false,
          "description": "使用可选 AI 模型结合上下文审校普通译文；关闭时保持原来的免费快速翻译。"
        },
        "cfInline.aiProvider": {
          "type": "string",
          "enum": ["ollama", "openaiCompatible"],
          "enumDescriptions": ["本机免费的 Ollama Chat API。", "OpenAI Chat Completions 兼容 API，支持不同厂商和模型。"],
          "default": "ollama",
          "description": "AI 增强翻译使用的接口协议。"
        },
        "cfInline.aiEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "AI 接口根地址或完整接口地址；外部服务必须使用 HTTPS，本机 Ollama 可使用 localhost HTTP。"
        },
        "cfInline.aiModel": {
          "type": "string",
          "default": "",
          "description": "AI 服务实际支持的模型 ID，由用户在配置时输入。"
        },
        "cfInline.aiTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 5000,
          "maximum": 300000,
          "description": "每批 AI 审校请求的超时时间（毫秒）。"
        },
        "cfInline.aiFallbackToStandard": {
          "type": "boolean",
          "default": true,
          "description": "AI 接口超时或失败时自动显示普通译文，而不是让整份题面翻译失败。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node test/unit-tests.js",
    "watch": "tsc -w -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "tough-cookie": "^4.1.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/tough-cookie": "^4.0.5",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.5.4"
  }
}
