{
  "manifest_version": 3,
  "name": "Codeforces Inline Edge Bridge",
  "version": "0.1.12",
  "description": "让 VS Code Codeforces Inline 安全复用日常 Edge 的登录状态。",
  "key": "",
  "permissions": ["tabs", "scripting", "cookies", "alarms", "storage"],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://m1.codeforces.com/*",
    "https://m2.codeforces.com/*",
    "https://m3.codeforces.com/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "Codeforces Inline 已启用" }
  ,"content_scripts": [{
    "matches": [
      "http://127.0.0.1/*",
      "https://codeforces.com/*",
      "https://m1.codeforces.com/*",
      "https://m2.codeforces.com/*",
      "https://m3.codeforces.com/*"
    ],
    "js": ["wake.js"],
    "run_at": "document_start"
  }]
}
